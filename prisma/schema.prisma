generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   GroupMember[]
  createdGroups Group[]       @relation("GroupCreator")
  expenses      Expense[]
  settlementsFrom Settlement[] @relation("SettlementFrom")
  settlementsTo   Settlement[] @relation("SettlementTo")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id          String        @id @default(cuid())
  name        String
  inviteToken String        @unique @default(cuid())
  creatorId   String
  creator     User          @relation("GroupCreator", fields: [creatorId], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([creatorId])
}

model GroupMember {
  groupId  String
  userId   String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model Expense {
  id          String         @id @default(cuid())
  groupId     String
  payerId     String
  description String
  amountCents Int
  category    String?
  occurredAt  DateTime       @default(now())
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer       User           @relation(fields: [payerId], references: [id])
  shares      ExpenseShare[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([groupId, occurredAt])
  @@index([payerId])
}

model ExpenseShare {
  expenseId  String
  memberId   String
  amountCents Int
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@id([expenseId, memberId])
  @@index([memberId])
}

model Settlement {
  id             String   @id @default(cuid())
  groupId        String
  fromMemberId   String
  toMemberId     String
  amountCents    Int
  settledAt      DateTime @default(now())
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMember     User     @relation("SettlementFrom", fields: [fromMemberId], references: [id])
  toMember       User     @relation("SettlementTo", fields: [toMemberId], references: [id])

  @@index([groupId, settledAt])
  @@index([fromMemberId])
  @@index([toMemberId])
}
